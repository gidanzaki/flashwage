# Copy this file to .env.local and fill in the values for whichever network
# you're pointed at. Nothing here is a secret — these are all public
# addresses/URLs the browser needs — so it's safe to commit *this* example
# file, just not a filled-in .env.local (already gitignored).

# --- Network -----------------------------------------------------------
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
NEXT_PUBLIC_HORIZON_URL="https://horizon-testnet.stellar.org"

# --- FlashWage escrow contract ------------------------------------------
# The C... address from `stellar contract deploy` (see root README.md).
NEXT_PUBLIC_ESCROW_CONTRACT_ID=""

# --- USDC (the accepted deposit asset) ----------------------------------
# Soroban-side (C...) address — used for create_milestone_escrow calls and
# must be one of the contract's accepted_assets set at `initialize`.
NEXT_PUBLIC_USDC_CONTRACT_ID=""
# Classic-side asset code + issuer (G...) — used for the worker's Path
# Payment withdrawal, which operates on the classic trustline balance.
NEXT_PUBLIC_USDC_ASSET_CODE="USDC"
NEXT_PUBLIC_USDC_ASSET_ISSUER=""

# --- Local off-ramp currencies (classic-layer issuers, G...) -----------
# Leave blank to hide a currency from the worker withdrawal dropdown, or if
# no liquidity path exists for it yet on your network.
NEXT_PUBLIC_ARS_ISSUER=""
NEXT_PUBLIC_BRL_ISSUER=""
NEXT_PUBLIC_EURC_ISSUER=""
